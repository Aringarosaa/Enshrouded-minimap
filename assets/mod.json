{
  "id": "minimap_mod",
  "version": "0.5.15",
  "name": "Shroudweave Minimap + Compass (Clear View)",
  "description": "In-game minimap, world clock, big map, exploration progress and teammates on the compass for Enshrouded, with colour-blind friendly colours.",
  "author": "Aerox912; original minimap by elxokker",
  "authors": [
    "elxokker",
    "Aerox912"
  ],
  "capabilities": [],
  "shroudtopia": {
    "default": {
      "active": true,
      "position": "bottom-right",
      "offset": 0,
      "map_orientation": "north-up",
      "toggle_key": "F10",
      "render_camera_fallback": true,
      "debug_logging": false,
      "show_other_players": true,
      "show_pings": true,
      "show_waypoints": true,
      "show_world_markers": true,
      "show_death_markers": true,
      "map_light": 20,
      "map_style": "default",
      "icon_style": "original",
      "heading_smoothing_ms": 55,
      "map_sample_step": 2,
      "max_icons": 64,
      "show_clock": true,
      "show_weather": true,
      "show_fog_of_war": true,
      "toggle_key_secondary": "0x6A",
      "zoom_in_key": "0xBB",
      "zoom_in_key_secondary": "0x6B",
      "zoom_out_key": "0xBD",
      "zoom_out_key_secondary": "0x6D",
      "scale_percent": 100,
      "size_decrease_key": "F9",
      "size_increase_key": "F11",
      "show_compass": false,
      "show_coordinates": false,
      "show_waypoint_distance": false,
      "show_height": false,
      "marker_colors": "colorblind",
      "compass_toggle_key": "F8",
      "compass_offset": 0,
      "compass_scale_percent": 100,
      "show_compass_players": true,
      "game_compass_offset": 0,
      "game_compass_width_percent": 100,
      "show_exploration": true,
      "big_map_key": "F7"
    }
  }
}
